{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM step registry",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": {"type": "integer"},
    "modalities_in_scope": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "scope", "modalities", "needs", "preconditions", "tolerates_missing",
                     "evidence", "evidence_level", "implemented", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[GS][0-9]+$"},
          "name": {"type": "string"},
          "kind": {"enum": ["audit", "action", "constraint"]},
          "scope": {"enum": ["global", "study_dependent"]},
          "modalities": {"type": "array", "items": {"enum": ["ms_proteomics", "affinity_proteomics", "metabolomics", "lipidomics"]}},
          "needs": {"type": "array", "items": {"enum": ["data", "technical_metadata", "qc_samples", "run_order",
            "batch_variable", "contrast_variable", "protected_variables", "downstream_family", "subject",
            "confirmed_processing_state"]}},
          "preconditions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["fact", "op", "text"],
            "properties": {"fact": {"type": "string"},
                           "op": {"enum": ["eq", "ne", "in", "not_in", "gt", "ge", "lt", "le", "exists", "is_true", "is_false"]},
                           "value": {}, "text": {"type": "string"}}}},
          "tolerates_missing": {"enum": ["yes", "no", "native", "not_applicable"]},
          "audits": {"type": "array", "items": {"type": "string", "pattern": "^A[0-9]+$"}},
          "ops": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_level": {"enum": ["literature_independent", "expert_guidance", "convention", "heuristic", "unverified"]},
          "implemented": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "candidates": {"type": "array", "items": {"type": "object", "required": ["id", "step", "name", "implemented", "evidence_level"],
      "properties": {"id": {"type": "string"}, "step": {"type": "string"}, "name": {"type": "string"},
                     "implemented": {"type": "boolean"}, "evidence": {"type": "array", "items": {"type": "string"}},
                     "evidence_level": {"enum": ["literature_independent", "expert_guidance", "convention", "heuristic", "unverified"]},
                     "notes": {"type": "string"}}}}
  }
}
