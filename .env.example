# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is git-ignored, so the key never gets committed.
GEMINI_API_KEY=

# Optional:
# LLM_PROVIDER=gemini            # gemini | anthropic | openai | mock (offline demo)
# PRISM_LLM_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# AI_SEND_EXAMPLE_VALUES=true    # false = send only column names and statistics
# PRISM_SCOPE_DESCRIPTION="..."  # what the audit supports; tables outside it get a notice, not a block
# PRISM_LITERATURE=on             # off = no Europe PMC search in step 4
